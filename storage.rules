rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Contratos dos fornecedores: só o casal (logado) envia/lê/remove.
    match /contratos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Bloqueia qualquer outro caminho por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
